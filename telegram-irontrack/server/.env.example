# Порт, на котором поднимется сервер
PORT=3000

# Откуда брать данные:
#   local  — локальный JSON-файл server/data/db.json, без Google Sheets вообще (для теста на ПК)
#   turso  — облачная SQLite-база на Turso (turso.tech), бесплатно, быстро, данные не пропадают
#            при перезапуске/передеплое сервера — то, что нужно для реального хостинга
#   sheets — прежний режим, читает/пишет в вашу Google Таблицу (медленнее, но данные видны
#            прямо в Google Sheets)
DB_DRIVER=local

# true — отключает проверку подписи Telegram initData, чтобы можно было открыть
# http://localhost:3000 прямо в обычном браузере на ПК и потыкать приложение без Telegram.
# Перед тем как выкладывать бота в реальный Telegram — обязательно поставьте false.
SKIP_TELEGRAM_AUTH=true

# Токен бота из @BotFather (нужен только когда SKIP_TELEGRAM_AUTH=false)
TELEGRAM_BOT_TOKEN=

# Через запятую — Telegram user_id, кому разрешено пользоваться ботом (узнать свой ID
# можно у @userinfobot). Оставьте пустым на время тестов.
ALLOWED_TELEGRAM_IDS=

# CORS: с какого origin разрешено дергать API. Для локального теста и Telegram обычно '*' ок.
ALLOWED_ORIGIN=*

# ---------------------------------------------------------------------------
# Нужны ТОЛЬКО если DB_DRIVER=turso
# ---------------------------------------------------------------------------
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Нужны ТОЛЬКО если DB_DRIVER=sheets (синхронизация с реальной Google Таблицей)
# ---------------------------------------------------------------------------
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
